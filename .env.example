# THE WORLD IS ALIVE — environment configuration (copy to .env)
# All variables are optional. The game runs fully offline without any of them.

# Optional LLM endpoint for narrative enhancement (news, social posts, God Mode interpretation, character dialogue).
# Must be an OpenAI-compatible chat/completions style HTTP endpoint or your own proxy.
# When empty, the deterministic local providers are used.
VITE_AI_ENDPOINT=
VITE_AI_MODEL=
# NEVER commit real keys. Prefer a server-side proxy so the key is not shipped to browsers.
VITE_AI_API_KEY=
