{
  "name": "the-world-is-alive",
  "private": true,
  "version": "0.1.0",
  "description": "THE WORLD IS ALIVE — a living procedural civilization simulator with God Mode.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node tests/e2e/smoke.mjs",
    "typecheck": "tsc --noEmit",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "idb-keyval": "^6.2.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "playwright": "^1.63.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vitest": "^3.2.0"
  }
}
